# Secrets and machine-local configuration
.env
.env.*
!.env.example
*.local.yaml
configs/ssh/*.local.conf

# Python and Conda
.venv/
.conda/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
htmlcov/

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db

# Large or generated research state
benchmark/source_snapshots/*
!benchmark/source_snapshots/.gitkeep
benchmark/synthetic/generated/
web_env/spoofed_sources/*
!web_env/spoofed_sources/.gitkeep
artifacts/runs/
artifacts/analyses/
artifacts/controller/
artifacts/figures/
artifacts/tables/
artifacts/publication/
/models/
/data/
*.parquet
*.arrow
*.safetensors
*.bin
*.pt
*.pth
*.onnx

# Runtime state and downloaded upstream checkouts
third_party/checkouts/
.playwright/
artifacts/system/*.local.json

# Keep directory placeholders and system audit records
!artifacts/system/
!artifacts/system/**
# Machine-specific probe records stay private even though audited system records are tracked.
artifacts/system/*.local.json
