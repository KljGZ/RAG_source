# Copy to .env locally. Never commit real credentials or API keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
HF_TOKEN=
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# Use explicit project paths on the compute host.
PROVTRUST_DATA_DIR=/home/USER/provtrust_data
PROVTRUST_CACHE_DIR=/home/USER/provtrust_cache
PROVTRUST_RUNS_DIR=/home/USER/provtrust_runs
PROVTRUST_MODEL_DIR=/home/USER/provtrust_cache/models
PROVTRUST_RESOURCE_ALLOCATION=
