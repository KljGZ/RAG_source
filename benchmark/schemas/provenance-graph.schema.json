{
  "$defs": {
    "EdgeType": {
      "enum": [
        "published_by",
        "cites",
        "copied_from",
        "derived_from",
        "paraphrased_from",
        "supports",
        "contradicts",
        "updates"
      ],
      "title": "EdgeType",
      "type": "string"
    },
    "ProvenanceEdge": {
      "additionalProperties": false,
      "properties": {
        "dst_node_id": {
          "minLength": 1,
          "title": "Dst Node Id",
          "type": "string"
        },
        "edge_id": {
          "minLength": 1,
          "title": "Edge Id",
          "type": "string"
        },
        "edge_type": {
          "$ref": "#/$defs/EdgeType"
        },
        "evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence"
        },
        "src_node_id": {
          "minLength": 1,
          "title": "Src Node Id",
          "type": "string"
        },
        "verified": {
          "title": "Verified",
          "type": "boolean"
        }
      },
      "required": [
        "edge_id",
        "src_node_id",
        "dst_node_id",
        "edge_type",
        "verified"
      ],
      "title": "ProvenanceEdge",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "edges": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProvenanceEdge"
      },
      "title": "Edges",
      "type": "array"
    },
    "graph_id": {
      "minLength": 1,
      "title": "Graph Id",
      "type": "string"
    },
    "node_ids": {
      "items": {
        "type": "string"
      },
      "title": "Node Ids",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "graph_id",
    "node_ids"
  ],
  "title": "ProvenanceGraph",
  "type": "object"
}
