{
  "$defs": {
    "ModelSpec": {
      "additionalProperties": false,
      "properties": {
        "max_tokens": {
          "exclusiveMinimum": 0,
          "title": "Max Tokens",
          "type": "integer"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "model_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Revision"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "system_prompt_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "System Prompt Hash",
          "type": "string"
        },
        "temperature": {
          "minimum": 0.0,
          "title": "Temperature",
          "type": "number"
        }
      },
      "required": [
        "provider",
        "model",
        "observed_at",
        "temperature",
        "max_tokens",
        "system_prompt_hash",
        "role"
      ],
      "title": "ModelSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "dataset_manifest_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Dataset Manifest Hash",
      "type": "string"
    },
    "environment_lock_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Environment Lock Hash",
      "type": "string"
    },
    "experiment_plan_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Experiment Plan Hash",
      "type": "string"
    },
    "git_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Git Commit",
      "type": "string"
    },
    "model_specs": {
      "items": {
        "$ref": "#/$defs/ModelSpec"
      },
      "title": "Model Specs",
      "type": "array"
    },
    "prompt_manifest_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Prompt Manifest Hash",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "seeds": {
      "items": {
        "type": "integer"
      },
      "title": "Seeds",
      "type": "array"
    },
    "shard_count": {
      "exclusiveMinimum": 0,
      "title": "Shard Count",
      "type": "integer"
    },
    "status": {
      "default": "created",
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "git_commit",
    "experiment_plan_hash",
    "dataset_manifest_hash",
    "prompt_manifest_hash",
    "model_specs",
    "seeds",
    "shard_count",
    "environment_lock_hash"
  ],
  "title": "RunManifest",
  "type": "object"
}
